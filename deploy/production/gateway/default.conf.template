# [5.3] #19. The gateway on every app server. The load balancer ends TLS and
# sends plain HTTP here; this file routes by host name:
#
#   <domain>             the built frontend
#   auth.<domain>        the auth service       (and market., ledger., audit.)
#   realtime.<domain>    the price websocket
#
# One subdomain per service, rather than one host with path prefixes, for the
# reason in ../../nginx.conf: the services do not namespace their paths, and
# the frontend already addresses each by its own URL. The login cookie names
# the parent domain, so it reaches every subdomain. ADR 0002.
#
# The nginx image fills in ${DOMAIN} when the container starts. nginx's own
# $variables are left alone, because DOMAIN is the only one it is given.

# Docker's own DNS, re-asked every 10 seconds. A service recreated by a deploy
# comes back on a new address, and nginx would otherwise keep the old one
# until it restarted. That only works when proxy_pass is a variable.
resolver 127.0.0.11 valid=10s ipv6=off;

# [BE][A-2] #600. The client's address as the load balancer saw it. Only the
# balancer, which connects from inside the VPC (infra/terraform/network.tf), is
# trusted to have written X-Forwarded-For; with real_ip_recursive, nginx takes
# the rightmost address no trusted hop added, so a header the visitor forged
# is ignored whether the balancer appends to it or replaces it.
set_real_ip_from 10.64.0.0/20;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# [BE][5.5] #599. The client's own request ID if it is safe by the services'
# rule (shared/request_ids.py), else nginx's. Checked here, not only there: it
# goes into the gateway's own log line, and an ID the service then replaced
# would no longer match. A 502 or 504 the gateway answers itself has no
# service log line, so its gateway line carries the ID. Quoted for the braces.
map $http_x_request_id $forwarded_request_id {
    "~^[A-Za-z0-9._-]{1,64}$" $http_x_request_id;
    default                   $request_id;
}

# The path, never the query string, which can hold a token or an email. The
# services log the route template for the same reason.
log_format cs464 '$remote_addr [$time_iso8601] "$request_method $uri" $status $body_bytes_sent rid=$forwarded_request_id';

# The load balancer's health check arrives by IP address, not by one of our
# names, so it lands here.
server {
    listen 80 default_server;

    # What the load balancer asks. 503 while roll.sh is draining this server,
    # so the balancer stops sending it traffic before anything restarts.
    # Otherwise the ledger's liveness: is the process up. Not its readiness.
    # The database is one managed instance shared by every server, so taking
    # servers out can never fix it. It would only turn "trades fail with an
    # error" into the balancer's bare 503 for the whole site, homepage
    # included, and make a deploy during a blip roll back. Readiness feeds the
    # dashboard and the alerts instead. ADR 0028.
    location = /lb-health {
        if (-f /etc/nginx/drain/on) {
            return 503;
        }
        set $ledger http://ledger:8000;
        proxy_pass $ledger/health;
    }

    # The container's own health check. Separate from /lb-health so that
    # draining does not make Docker think the gateway itself is broken.
    location = /gateway-health {
        return 200;
    }

    location / {
        return 404;
    }
}

server {
    listen 80;
    server_name ${DOMAIN};
    root /usr/share/nginx/html;

    # Vite fingerprints everything under assets/, so it can be cached for good.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # A client-side route (/markets/…) is the app's, not a file.
    location / {
        try_files $uri /index.html;
    }

    # index.html names the current assets, so it is never cached.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
}

server {
    listen 80;
    server_name auth.${DOMAIN};
    location / {
        set $upstream http://auth:8000;
        proxy_pass $upstream;
        include /etc/nginx/conf.d/proxy-headers.inc;
    }
    include /etc/nginx/conf.d/private-paths.inc;
}

server {
    listen 80;
    server_name market.${DOMAIN};
    location / {
        set $upstream http://market:8000;
        proxy_pass $upstream;
        include /etc/nginx/conf.d/proxy-headers.inc;
    }
    include /etc/nginx/conf.d/private-paths.inc;
}

server {
    listen 80;
    server_name ledger.${DOMAIN};
    location / {
        set $upstream http://ledger:8000;
        proxy_pass $upstream;
        include /etc/nginx/conf.d/proxy-headers.inc;
    }
    include /etc/nginx/conf.d/private-paths.inc;
}

server {
    listen 80;
    server_name audit.${DOMAIN};
    location / {
        set $upstream http://audit:8000;
        proxy_pass $upstream;
        include /etc/nginx/conf.d/proxy-headers.inc;
    }
    include /etc/nginx/conf.d/private-paths.inc;
}

server {
    listen 80;
    server_name realtime.${DOMAIN};
    location / {
        set $upstream http://realtime:8000;
        proxy_pass $upstream;
        include /etc/nginx/conf.d/proxy-headers.inc;
        # A websocket: pass the upgrade on, and give a quiet socket an hour
        # instead of nginx's default minute. The load balancer closes it at
        # 600 s first (infra/terraform/load_balancer.tf).
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
    include /etc/nginx/conf.d/private-paths.inc;
}
