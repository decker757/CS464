%% 10 — Two app servers in production: what scales and what does not ([5.3] #19)
%% Drawn from: ADR 0011, ADR 0020, ADR 0021, ADR 0026, docs/deployment.md,
%%   deploy/production/{compose.yml,release.sh,migrate.sh}, infra/terraform/{variables,load_balancer}.tf,
%%   backend/ledger_service/core/config.py, backend/market_service/service/closing.py,
%%   DECISIONS.md "Each service's connection pool is a setting, sized to the database's ceiling"
%% Pool + overflow per server (compose.yml): auth 3+1, market 3+2, ledger 6+3, audit
%% 1+1 = 20. Two servers 40, plus 3 migrate steps, against about 47 on the 2 GB plan.
%% LEADERBOARD_REFRESH_ENABLED is true on the first server only (release.sh app_env_for).
%% The ledger's calls reach auth and market on its own server: compose sets no
%% MARKET_SERVICE_URL or AUTH_SERVICE_URL, so config.py's defaults name those containers.
%% The local run of the same idea, one host and one nginx, is docs/horizontal-scaling.md.
%% ELK lays siblings out in reverse source order here, so app-2 is written first.
%%{init: {"elk": {"lineHops": false, "forceNodeModelOrder": true, "mergeEdges": true}, "flowchart": {"wrappingWidth": 620, "nodeSpacing": 10, "rankSpacing": 30, "padding": 6}, "themeVariables": {"fontSize": "21px"}}}%%
flowchart LR
    client["Browser"]
    lb["Load balancer:<br/>any server tagged<br/>cs464-app whose<br/>/lb-health answers 200"]

    subgraph s2["cs464-app-2: pool + overflow"]
        gw2["gateway"]
        a2["auth 3+1"]
        m2["market 3+2, sweeper"]
        l2["ledger 6+3;<br/>calls auth, market here"]
        u2["audit 1+1"]
        r2["realtime, no database"]
        gw2 --> a2
        gw2 --> m2
        gw2 --> l2
        gw2 --> u2
        gw2 --> r2
    end

    subgraph s1["cs464-app-1: pool + overflow"]
        gw1["gateway"]
        a1["auth 3+1"]
        m1["market 3+2, sweeper"]
        l1["ledger 6+3, refresher;<br/>calls auth, market here"]
        u1["audit 1+1"]
        r1["realtime, no database"]
        gw1 --> a1
        gw1 --> m1
        gw1 --> l1
        gw1 --> u1
        gw1 --> r1
    end

    db[("Postgres × 1<br/>20 + 20 + 3 migrate steps,<br/>of about 47. A third server<br/>needs smaller pools<br/>or a bigger plan")]
    bus[("Valkey × 1<br/>PUBLISH, SUBSCRIBE")]

    client --> lb
    lb --> s2
    lb --> s1
    s2 --> db
    s1 --> db
    s2 --> bus
    s1 --> bus

