%% 10 — Two of every service behind one nginx, locally ([5.4] #440)
%% Drawn from: ADR 0002, ADR 0010, ADR 0011, ADR 0020, ADR 0021,
%%   docker-compose.yml, docker-compose.scale.yml, deploy/nginx.conf,
%%   docs/horizontal-scaling.md, backend/realtime_service/service/bus.py,
%%   backend/market_service/service/closing.py, backend/ledger_service/service/leaderboard.py
%% Keep the listeners and services in the order written, 18000 to 18004.
%%{init: {"elk": {"forceNodeModelOrder": true}}}%%
flowchart LR
    client["Browser<br/>or e2e"]

    subgraph local["docker-compose.scale.yml — local, one host"]
        subgraph proxyBox["proxy: nginx<br/>1 worker, round robin<br/>Upgrade, read 300 s"]
            direction TB
            p0["18000 → auth"]
            p1["18001 → market"]
            p2["18002 → audit"]
            p3["18003 → ledger"]
            p4["18004 → realtime"]
        end

        auth@{ shape: procs, label: "auth × 2" }
        market@{ shape: procs, label: "market × 2<br/>sweeper on both:<br/>SKIP LOCKED" }
        audit@{ shape: procs, label: "audit × 2" }
        ledger@{ shape: procs, label: "ledger × 2<br/>refresher on both:<br/>advisory lock.<br/>Calls auth, market<br/>direct, not nginx" }

        subgraph realtimeR["realtime × 2, either one"]
            rt1["realtime-1"]
            rt2["realtime-2"]
        end

        authMig["auth-migrate × 1<br/>exit 0 gates both"]
        marketMig["market-migrate × 1<br/>exit 0 gates both"]
        ledgerMig["ledger-migrate × 1<br/>exit 0 gates both"]

        db[("Postgres<br/>× 1")]
        redis[("Redis<br/>× 1")]
    end

    client --> p0
    client --> p1
    client --> p2
    client --> p3
    client -->|"ws"| p4

    p0 --> auth
    p1 --> market
    p2 --> audit
    p3 --> ledger
    p4 --> realtimeR

    auth --> db
    market --> db
    audit --> db
    ledger --> db
    ledger -->|"PUBLISH"| redis
    authMig --> auth
    marketMig --> market
    ledgerMig --> ledger
    rt1 -->|"SUBSCRIBE"| redis
    rt2 -->|"SUBSCRIBE"| redis

    classDef browser  fill:#F2F2F2,stroke:#555555,color:#1A202C
    classDef edge     fill:#FFF4CC,stroke:#9A7B00,color:#1A202C
    classDef auth     fill:#DCEBFA,stroke:#2F6DB5,color:#1A202C
    classDef market   fill:#DFF2E1,stroke:#2E8B47,color:#1A202C
    classDef ledger   fill:#FCEBCF,stroke:#C27C0E,color:#1A202C
    classDef audit    fill:#ECE3F7,stroke:#7048A8,color:#1A202C
    classDef realtime fill:#DDF3F3,stroke:#1F8A8A,color:#1A202C
    classDef pg       fill:#E6EBF2,stroke:#3B5068,color:#1A202C
    classDef redis    fill:#FBE0DE,stroke:#C0392B,color:#1A202C
    classDef job      fill:#FFFFFF,stroke:#4A5568,color:#1A202C,stroke-dasharray:2 2
    classDef planned  fill:#FFFFFF,stroke:#888888,color:#555555,stroke-dasharray:6 4
    classDef ext      fill:#FFFFFF,stroke:#4A5568,color:#1A202C

    class client browser
    class p0,p1,p2,p3,p4 edge
    class auth auth
    class market market
    class audit audit
    class ledger ledger
    class authMig auth
    class marketMig market
    class ledgerMig ledger
    class rt1,rt2 realtime
    class db pg
    class redis redis
