%% 02 — Production on DigitalOcean, as built ([5.3] #19)
%% Drawn from: ADR 0026, ADR 0002, ADR 0010, ADR 0011, ADR 0020, ADR 0021,
%%   docs/deployment.md, infra/terraform/{network,load_balancer,servers,databases,dns,secrets,outputs}.tf,
%%   infra/terraform/variables.tf, infra/push-secrets.sh,
%%   deploy/production/{compose.yml,release.sh}, deploy/production/gateway/default.conf.template,
%%   .github/workflows/deploy.yml
%% Solid: built. Dashed and "not built": what ADR 0026's Consequences say is missing.
%% The firewall (servers.tf) admits :80 from the load balancer only, and :22 from
%% anywhere, keys only, because GitHub's runners have no fixed address. The gateway
%% is the only container publishing a port (compose.yml).
%% app.env takes the role URLs, with each role's password inside, JWT_SECRET,
%% LEDGER_SERVICE_KEY and REDIS_URL, under umask 077. Only the admin URL stays out of
%% it, reaching a server on stdin (release.sh). DigitalOcean makes the doadmin password
%% and the Valkey URL, which Terraform reads; REGISTRY_TOKEN is the run's GITHUB_TOKEN.
%% Connections: 20 per server at full overflow (compose.yml), 40 for two, against about
%% 47 on the 2 GB plan (ADR 0026), which leaves room for the migrate steps. Those run
%% one after another (migrate.sh), so the 3 in deployment.md is a budget, not a peak.
%% The VPC title has right padding so the browser arrow misses it. ELK lays
%% siblings out in reverse source order here, so app-2 is written before app-1.
%% Mermaid 12 redraws a dashed edge solid where it hops another line; no dashed edges here.
%%{init: {"elk": {"lineHops": false, "forceNodeModelOrder": true, "mergeEdges": true}, "flowchart": {"wrappingWidth": 620, "nodeSpacing": 18, "rankSpacing": 26, "padding": 8}, "themeVariables": {"fontSize": "22px"}}}%%
flowchart TB
    subgraph ops["Outside DigitalOcean"]
        tf["Terraform: all of DigitalOcean,<br/>every generated secret"]
        images["deploy.yml, main only:<br/>builds 6 images"]
        env["GitHub production<br/>environment: secrets"]
        ghcr[("GHCR<br/>tag = commit")]
        tf -->|"push-secrets.sh"| env
        images -->|"push"| ghcr
    end

    browser["Browser"]

    subgraph gaps["Not built (ADR 0026)"]
        staging["staging: own domain,<br/>own database; no open issue"]
        limit["login rate<br/>limit (#600)"]
        mon["monitoring, alerts<br/>(#599)"]
        staging ~~~ limit
        limit ~~~ mon
    end

    subgraph do["<span style='padding-right:330px'>DigitalOcean sgp1: VPC 10.64.0.0/20</span>"]
        lb["Load balancer: ends TLS with Let's Encrypt,<br/>sends only to servers whose /lb-health answers 200"]

        subgraph fw["Firewall: :80 LB; :22 open, keys only"]
            subgraph s2["cs464-app-2, 1 vCPU, 2 GB"]
                gw2["gateway: nginx, frontend,<br/>routes each subdomain to"]
                svc2["<span style='background:#DCEBFA'>&nbsp;auth&nbsp;</span> <span style='background:#DFF2E1'>&nbsp;market&nbsp;</span> <span style='background:#FCEBCF'>&nbsp;ledger&nbsp;</span><br/><span style='background:#ECE3F7'>&nbsp;audit&nbsp;</span> <span style='background:#DDF3F3'>&nbsp;realtime&nbsp;</span>"]
                gw2 --> svc2
            end
            subgraph s1["cs464-app-1, 1 vCPU, 2 GB"]
                gw1["gateway: nginx, frontend,<br/>routes each subdomain to"]
                svc1["<span style='background:#DCEBFA'>&nbsp;auth&nbsp;</span> <span style='background:#DFF2E1'>&nbsp;market&nbsp;</span> <span style='background:#FCEBCF'>&nbsp;ledger&nbsp;</span><br/><span style='background:#ECE3F7'>&nbsp;audit&nbsp;</span> <span style='background:#DDF3F3'>&nbsp;realtime&nbsp;</span>"]
                gw1 --> svc1
            end
        end

        valkey[("Managed Valkey 8,<br/>1 GB, 1 node")]
        pg[("Managed Postgres 17, 2 GB, 1 node, daily backups;<br/>20 connections a server, 40 of about 47")]
        standby[("not built:<br/>Postgres standby")]
    end

    browser -->|"https, wss"| lb
    lb -->|":80, http"| s2
    lb -->|":80, http"| s1

    s2 --> pg
    s1 --> pg
    s2 --> valkey
    s1 --> valkey
    s2 ~~~ standby

    env -->|"release.sh, SSH:<br/>release dir, app.env"| fw
    ghcr -->|"servers pull"| fw

    classDef browser  fill:#F2F2F2,stroke:#555555,color:#1A202C
    classDef edge     fill:#FFF4CC,stroke:#9A7B00,color:#1A202C
    classDef pg       fill:#E6EBF2,stroke:#3B5068,color:#1A202C
    classDef redis    fill:#FBE0DE,stroke:#C0392B,color:#1A202C
    classDef planned  fill:#FFFFFF,stroke:#888888,color:#555555,stroke-dasharray:6 4
    classDef ext      fill:#FFFFFF,stroke:#4A5568,color:#1A202C

    class browser browser
    class lb,gw1,gw2 edge
    class svc1,svc2 ext
    class pg pg
    class valkey redis
    class tf,env,images,ghcr ext
    class standby,staging,mon,limit planned
    style gaps stroke-dasharray:6 4,fill:#FFFFFF
