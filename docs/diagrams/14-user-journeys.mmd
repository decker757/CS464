%% 14 — Four user journeys, step by step
%% Drawn from: ADR 0008, ADR 0009, ADR 0010, ADR 0011, ADR 0013, ADR 0014,
%%   ADR 0016, ADR 0019, ADR 0023, ADR 0024, ADR 0029,
%%   backend/auth_service/controller/routes.py,
%%   backend/ledger_service/controller/routes.py,
%%   backend/ledger_service/service/ledger_service.py, service/grants.py,
%%   service/trading.py, service/orders.py, service/settlement.py, service/bus.py,
%%   backend/market_service/controller/routes.py,
%%   backend/market_service/service/market_service.py, service/closing.py,
%%   backend/market_service/core/settling.py, core/config.py,
%%   backend/realtime_service/controller/routes.py, service/subscriptions.py,
%%   frontend/src/context/BalanceContext.tsx, frontend/src/hooks/useMarketPrices.ts,
%%   frontend/src/hooks/useMyOrders.ts, frontend/src/pages/admin/CreateMarketPage.tsx,
%%   frontend/src/components/markets/TradingPanel.tsx
%% -
%% Box colour = the service that handles the step. "…" stands for the
%% service's market prefix: /ledger/markets/{id} on a ledger box,
%% /markets/{id} on a market box. Every step exists in the code today.
%% a4: a trade is decided by its price limit (ADR 0029). The trade panel
%% still sends the quote's state_version instead until [FE] #644 lands,
%% and the ledger still accepts that; then "or the quote's" goes.
%%{init: {"flowchart": {"wrappingWidth": 200, "nodeSpacing": 14, "rankSpacing": 20, "padding": 8}}}%%
flowchart TB
    subgraph j1["1 · A new trader's first trade"]
        direction LR
        a1["Trader registers<br/>POST /auth/register"]:::auth
        a2["First balance read<br/>mints signup-grant"]:::ledger
        a3["Opens a market,<br/>reads its snapshot"]:::ledger
        a4["Buys, POST …/trades,<br/>with a price limit,<br/>or the quote's<br/>state_version"]:::ledger
        a5["On /ws/prices, a<br/>market.price frame<br/>moves the price"]:::realtime
        a1 --> a2 --> a3 --> a4 --> a5
    end

    subgraph j2["2 · An admin drafts, submits and publishes"]
        direction LR
        b1["Autosave every 3 s<br/>POST /markets, draft"]:::market
        b2["Submit: 422 unless<br/>every rule passes"]:::market
        b3["Creator publishes<br/>POST …/publish<br/>rules re-run now"]:::market
        b4["open: terms frozen,<br/>any save is 409"]:::market
        b1 --> b2 --> b3 --> b4
    end

    subgraph j3["3 · Two admins resolve, the ledger pays"]
        direction LR
        c1["Clock or admin<br/>closes → closed"]:::market
        c2["Creator proposes<br/>→ pending_resolution"]:::market
        c3["2nd admin approves<br/>its proposal_id<br/>→ approved"]:::market
        c4["24 h window:<br/>any admin may<br/>send it back"]:::market
        c5["Admin settles,<br/>≥ window + 5 min:<br/>ledger pays, then<br/>market → settled"]:::ledger
        c1 --> c2 --> c3 --> c4 --> c5
    end

    subgraph j4["4 · Trader A's limit order fills inside B's trade"]
        direction LR
        d1["A buys at a limit<br/>POST …/orders<br/>binary only"]:::ledger
        d2["Rests unfilled,<br/>budget reserved"]:::ledger
        d3["B buys the other<br/>outcome: price falls<br/>past A's limit"]:::ledger
        d4["Cascade fills A<br/>in B's commit"]:::ledger
        d5["order.update to<br/>A's socket: fill<br/>shown on A's row"]:::realtime
        d1 --> d2 --> d3 --> d4 --> d5
    end

    j1 ~~~ j2 ~~~ j3 ~~~ j4

