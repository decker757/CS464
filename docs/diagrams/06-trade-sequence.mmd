%% 06 — A trade, end to end
%% Drawn from: ADR 0009, ADR 0010, ADR 0015, ADR 0017 and ADR 0022 (both as
%%   amended by ADR 0030), ADR 0024, ADR 0029, ADR 0030, D-049,
%%   DECISIONS.md "One price frame per commit, at the final state_version",
%%   backend/ledger_service/service/trading.py (execute, read_trade_context),
%%   backend/ledger_service/service/local_copy.py (refuse_if_suspended,
%%   ensure_trading, fetch_suspended, fetch_published_markets),
%%   backend/ledger_service/main.py (_start_copy_refreshers),
%%   backend/ledger_service/core/config.py (local_copy_refresh_seconds 1.0,
%%   local_copy_max_age_seconds 5.0),
%%   backend/ledger_service/core/pricing.py (trade_cost_of, refuse_if_beyond_limit),
%%   backend/ledger_service/core/errors.py (AccountSuspended, MarketClosed,
%%   AuthUnavailable, MarketTermsUnavailable, PriceBeyondLimit),
%%   backend/ledger_service/model/schemas.py (TradeIn: max_cost, min_proceeds),
%%   backend/ledger_service/controller/routes.py (POST /markets/{id}/trades, 201),
%%   backend/ledger_service/service/bus.py, backend/realtime_service/service/bus.py
%% Filled arrowheads: synchronous calls. Open arrowheads (-)): async pub/sub.
%% "stale" is a copy older than local_copy_max_age_seconds, five seconds:
%% 503 auth_unavailable or market_terms_unavailable. Closed is 409 market_closed.
%% Left out to keep one path: a market missing from the copy (published under a
%% second ago) makes the trade fetch /internal/markets/published itself, or answer
%% 404 (local_copy.ensure_trading); a key found again under the lock is answered
%% as a replay (trading.py step 6); a body with no limit is decided by
%% state_version (409 quote_stale); a book's first touch opens and funds it and a
%% trader's first read mints the grant, both before the lock; and the latch and
%% close_time refusals that the context statement decides (409 market_closed).
%% The two in-memory steps are notes, so they take no step number.
%%{init: {"sequence": {"width": 100, "actorMargin": 35}, "themeCSS": ".actor-line { stroke: #C3CBD5 !important; stroke-dasharray: 3 3; }"}}%%
sequenceDiagram
    autonumber
    participant B as Browser
    participant RT as realtime
    participant A as auth
    participant M as market
    participant L as ledger
    participant DB as Postgres
    participant R as Redis

    loop each second, every ledger
        L->>A: GET /internal/<br/>users/suspended
        L->>M: GET /internal/<br/>markets/published
        Note right of L: service<br/>key
    end
    B->>L: POST /ledger/markets/{id}/trades<br/>max_cost or min_proceeds
    L->>DB: read key,<br/>no lock
    alt key already committed: a replay
        L-->>B: 201, the stored result
    else first time
        Note right of L: the copy:<br/>suspended<br/>403, closed<br/>409, stale<br/>503
        L->>DB: lock book,<br/>FOR UPDATE
        L->>DB: one statement:<br/>key, latch,<br/>close_time,<br/>q, position
        Note right of L: LMSR price<br/>vs the limit
        alt beyond the limit
            L-->>B: 409 price_beyond_limit, nothing written
        else within it
            L->>DB: write q,<br/>position,<br/>entries, fills,<br/>COMMIT
            L-)R: PUBLISH market.price<br/>(failure logged)
            L-->>B: 201, the trade result
            R-)RT: price frame
            RT-)B: price frame<br/>on /ws/prices
        end
    end
