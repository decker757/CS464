# Only needed to run this service directly on the host with uvicorn.
# Under docker compose the repo-root .env supplies everything instead.
# Copy to .env and fill in. .env is gitignored; never put a real value here.

# Required, no default. Async driver only, and market_svc rather than the
# superuser, so the grants in sql/02-schemas.sql actually constrain this
# service. `localhost` from the host, `db` from inside compose.
DATABASE_URL=postgresql+asyncpg://market_svc:<PASSWORD>@localhost:<PORT>/cs464

# Required, no default, at least 16 characters. Must be byte-for-byte the value
# the auth service signs with, or every request here is a 401. This service only
# verifies; see docs/adr/0002-auth-token-transport.md before sharing the value.
JWT_SECRET=

# All three must match the auth service or no token will validate.
JWT_ALGORITHM=HS256
JWT_ISSUER=cs464-auth
ACCESS_COOKIE_NAME=access_token

# Exact origins, comma separated. "*" is invalid with credentialed requests.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
