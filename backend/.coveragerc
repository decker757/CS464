# What the backend coverage figure counts. [F-12] #342.
#
# One file for all six suites rather than six copies: each job points at it
# with COVERAGE_RCFILE, and the paths below are relative to whichever service
# directory pytest ran in.

[run]
branch = false
omit =
    # The tests are not the thing being measured.
    unit_test/*
    # Third-party code, and the virtualenv a local run measures from.
    .venv/*
    */site-packages/*
    # Alembic revisions run in the migrate step, never in a unit test, so
    # counting them would lower the figure for code no test is meant to run.
    # `test_migrations.py` is what holds them to the models instead (ADR 0020).
    migrations/*
