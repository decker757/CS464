# Only needed to run this service directly on the host with uvicorn.
# Under docker compose the repo-root .env supplies everything instead.
# Copy to .env and fill in. .env is gitignored; never put a real value here.

# Required, no default. Async driver only.
# `localhost` from the host, `db` from inside compose.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:PORT/cs464

# Required, no default, at least 16 characters. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Every service that verifies a token needs this same value. See
# docs/adr/0002-auth-token-transport.md before sharing it.
JWT_SECRET=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# Must be false over plain http, or the browser silently drops the cookie.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

PASSWORD_MIN_LENGTH=12

# Exact origins, comma separated. "*" is invalid with credentialed requests.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
