# Repo-root environment for docker compose. Copy to .env and fill in.
# .env is gitignored. Never put a real value in this file.

POSTGRES_USER=cs464
POSTGRES_DB=cs464
POSTGRES_PORT=5432

# Required. Any value for local dev; compose refuses to start without it.
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# Required. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Where the test suite connects. Substitute the three values above.
# Note cs464_test, not cs464: the suite truncates every table it finds.
TEST_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:PORT/cs464_test

# false over plain http, or the browser drops the auth cookie.
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
AUTH_PORT=8000
