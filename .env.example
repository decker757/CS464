# Repo-root environment for docker compose. Copy to .env and fill in.
# .env is gitignored. Never put a real value in this file.

POSTGRES_USER=cs464
POSTGRES_DB=cs464
POSTGRES_PORT=5432

# All required. Any value for local dev; compose refuses to start without them.
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# POSTGRES_PASSWORD is the superuser. The per-service roles are what the
# applications actually connect as, so they are constrained by the grants in
# sql/02-schemas.sql.
POSTGRES_PASSWORD=
AUTH_DB_PASSWORD=
LEDGER_DB_PASSWORD=
MARKET_DB_PASSWORD=
AUDIT_DB_PASSWORD=

# Required. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Where each test suite connects: as that service's own role, so tests run
# under the same grants as production. Note cs464_test, not cs464. One variable
# per service, because a suite connecting as the wrong role would pass while
# proving nothing about the boundary.
AUTH_TEST_DATABASE_URL=postgresql+asyncpg://auth_svc:<AUTH_DB_PASSWORD>@localhost:<POSTGRES_PORT>/cs464_test
MARKET_TEST_DATABASE_URL=postgresql+asyncpg://market_svc:<MARKET_DB_PASSWORD>@localhost:<POSTGRES_PORT>/cs464_test
LEDGER_TEST_DATABASE_URL=postgresql+asyncpg://ledger_svc:<LEDGER_DB_PASSWORD>@localhost:<POSTGRES_PORT>/cs464_test

# [4.3] #15. Used by TWO suites, which is why it is worth spelling out.
# The audit service's own tests connect with it, and so do the market service's
# audit tests — those append an entry and then have to read it back, and
# market_svc deliberately cannot: it holds INSERT on audit.admin_actions and no
# SELECT, so that no service can read another's actions. Verifying an
# append-only log means connecting as the role allowed to read it.
AUDIT_TEST_DATABASE_URL=postgresql+asyncpg://audit_svc:<AUDIT_DB_PASSWORD>@localhost:<POSTGRES_PORT>/cs464_test

# Optional. The LMSR liquidity a new market gets when the admin does not choose
# one; they can override it per market. Higher means prices move less per trade
# and the platform's worst case, b*ln(n), is larger. Unlike the values above
# this one has a default and compose starts without it.
DEFAULT_LIQUIDITY_B=100

# [F-1] #41 / [B-1] #32. The starting mock credits every new account is granted,
# once, on the first read of its balance. Optional like the line above and for
# the same reason: it is a number, not a credential.
#
# Changing it does not re-grant anybody. The grant is keyed on the user id and
# written once as an append-only ledger entry, so a new value reaches accounts
# created after it and nothing else.
STARTING_CREDITS=1000

# [F-2] #42. The pub/sub channel a committed trade's new price travels on, from
# the trading service to the websocket server. Only the realtime service reads
# it and only the trading service writes it; no other service knows Redis
# exists.
#
# Required by the realtime service, with no default, for the same reason
# DATABASE_URL is: it is a credential the moment it carries a password, and a
# service pointed at the wrong Redis looks perfectly healthy while broadcasting
# to nobody. Local Redis needs no password, so there is none in this line.
#
# The realtime suite reads REALTIME_TEST_REDIS_URL if you want tests on a
# separate instance; otherwise it uses REDIS_URL. Pub/sub stores nothing, so
# unlike the databases there is nothing for a test run to clobber.
REDIS_PORT=6379
REDIS_URL=redis://localhost:<REDIS_PORT>/0

# false over plain http, or the browser drops the auth cookie.
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
AUTH_PORT=8000
MARKET_PORT=8001
AUDIT_PORT=8002
LEDGER_PORT=8003
REALTIME_PORT=8004
