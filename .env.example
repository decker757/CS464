# Repo-root environment for docker compose. Copy to .env and fill in.
# .env is gitignored. Never put a real value in this file.

POSTGRES_USER=cs464
POSTGRES_DB=cs464
POSTGRES_PORT=5432

# All required. Any value for local dev; compose refuses to start without them.
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# POSTGRES_PASSWORD is the superuser. The per-service roles are what the
# applications actually connect as, so they are constrained by the grants in
# sql/02-schemas.sql.
POSTGRES_PASSWORD=
AUTH_DB_PASSWORD=
LEDGER_DB_PASSWORD=

# Required. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Where the test suite connects: as auth_svc, so tests run under the same
# grants as production. Note cs464_test, not cs464.
TEST_DATABASE_URL=postgresql+asyncpg://auth_svc:<AUTH_DB_PASSWORD>@localhost:<POSTGRES_PORT>/cs464_test

# false over plain http, or the browser drops the auth cookie.
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
AUTH_PORT=8000
